# Ключи приложения Telegram: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

TG_SESSION=/var/lib/tg-mcp/session
TG_PORT=8765

# Куда разрешена отправка: me = Избранное, id чатов через запятую (из list_chats), * = любые
TG_SEND_ALLOW=me
MAX_SEND_ALLOW=
# Общий лимит отправок в минуту (Telegram + MAX)
TG_SEND_PER_MIN=10

# 1 = только чтение: инструменты отправки и изменения не регистрируются
READ_ONLY=0
# 0 = выключить MAX
MAX_ENABLED=1
# Автономный агент диалога (agent_start): ключ API Claude. Из России api.anthropic.com закрыт, поэтому
# запросы идут через TG_PROXY (или AGENT_PROXY). Без ключа агент не запускается.
# Бесплатно: ключ из https://aistudio.google.com (Get API key), модель gemini-3.6-flash
# GEMINI_API_KEY=
# Платно (Claude): ANTHROPIC_API_KEY=, AGENT_MODEL=claude-opus-5-5 (дешевле: claude-haiku-5-5)
# Любая модель с OpenAI-совместимым API (OpenRouter, Groq, Cerebras, Mistral…): берите самую крупную
# AGENT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_API_KEY=
# AGENT_MODEL=
# ANTHROPIC_API_KEY=
# AGENT_BRAIN=openai   (или gemini, anthropic)
# AGENT_THINKING=low
# AGENT_MAX_REPLIES=20
# AGENT_TTL_HOURS=12

# Часовой пояс для времени сообщений Telegram
TZ_NAME=Europe/Moscow

# Прокси для Telegram, если он заблокирован у хостера (setup-vpn.sh пропишет сам)
# TG_PROXY=socks5://127.0.0.1:1080

# TG_SECRET дописывается установщиком автоматически
