# Ключи приложения Telegram: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

TG_SESSION=/var/lib/tg-mcp/session
TG_PORT=8765

# Куда разрешена отправка: me = Избранное, id чатов через запятую (из list_chats), * = любые
TG_SEND_ALLOW=me
MAX_SEND_ALLOW=
# Общий лимит отправок в минуту (Telegram + MAX)
TG_SEND_PER_MIN=10

# 1 = только чтение: инструменты отправки и изменения не регистрируются
READ_ONLY=0
# 0 = выключить MAX
MAX_ENABLED=1
# Часовой пояс для времени сообщений Telegram
TZ_NAME=Europe/Moscow

# Прокси для Telegram, если он заблокирован у хостера (setup-vpn.sh пропишет сам)
# TG_PROXY=socks5://127.0.0.1:1080

# TG_SECRET дописывается установщиком автоматически
