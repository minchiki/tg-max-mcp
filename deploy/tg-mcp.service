[Unit]
Description=tg-max-mcp (Telegram + MAX MCP server)
After=network-online.target xray.service
Wants=network-online.target

[Service]
User=tgmcp
Group=tgmcp
WorkingDirectory=/opt/tg-mcp
EnvironmentFile=/etc/tg-mcp/env
ExecStart=/opt/tg-mcp/venv/bin/python /opt/tg-mcp/server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tg-mcp

[Install]
WantedBy=multi-user.target
